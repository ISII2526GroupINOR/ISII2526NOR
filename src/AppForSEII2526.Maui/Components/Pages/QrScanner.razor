@page "/qr"
@inject IJSRuntime JS
@implements IAsyncDisposable

<h3>QR Scanner</h3>

<div class="d-flex justify-content-center align-items-center">
    <div class="center selection-widget">
        <div class="title-widget">SCAN QR</div>
        @if (isRendered)
        {
            <div id="qr-reader"
                 class="d-flex justify-content-center align-items-center"
                 style="width:75%; max-width:1000px; margin:0 auto;">
            </div>
        }
    </div>
</div>



