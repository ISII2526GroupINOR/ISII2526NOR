<!-- CODE -->
@code {
    [Inject] NavigationManager Nav { get; set; }
    async void GoProfile() {
        await StopScan();
        Nav.NavigateTo("/adminprofile");
    }
    async void GoHome() {
        await StopScan();
        Nav.NavigateTo("/adminhome");
    }
    async void Exit() {
        await StopScan();
        Nav.NavigateTo("/");
    }
 


    private bool isRendered;
    private string result;
    private DotNetObjectReference<QrScanner> objRef;

    protected override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isRendered = true;
            StateHasChanged();

            // Wait one render cycle so the DIV exists
            await Task.Delay(100);

            await JS.InvokeVoidAsync(
                "qrScanner.start",
                "qr-reader",
                objRef
            );
        }
    }

    [JSInvokable]
    public async Task OnQrScanned(string code)
    {
        result = $"Scanned: {code}";
        await StopScan();
        StateHasChanged();
    }

    private async Task StopScan()
    {
        try
        {
            await JS.InvokeVoidAsync("qrScanner.stop");
        }
        catch
        {
            // Ignore if already stopped
        }
    }

    public async ValueTask DisposeAsync()
    {
        await StopScan();
        objRef?.Dispose();
    }

}